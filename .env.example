# SXMCARDS environment — copy to `.env` and fill in values (never commit secrets).

# --- Frontend (public URL — phone/browser uses this port only) ---
VITE_ONLINE_MODE=true
# Leave empty in dev — browser uses same-origin /api via Vite proxy (localhost + LAN both work).
VITE_API_URL=
VITE_TABLE_HOST=
VITE_EMAIL_INVITES=true
VITE_PORT=5173

# --- Dev origin (magic/invite links follow detected LAN IP; .env not overwritten) ---
DEV_PUBLIC_ORIGIN=auto
PUBLIC_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- API (internal in dev; auto-picks free port if API_PORT is busy) ---
API_PORT=3017
API_HOST=127.0.0.1
NODE_ENV=development
SESSION_SECRET=generate-a-long-random-secret
SESSION_COOKIE_NAME=sxmcards_session
SESSION_MAX_AGE_MS=604800000
MAGIC_LINK_TTL_MS=900000
MAGIC_LINK_RESEND_COOLDOWN_MS=60000
EMAIL_INVITES=true

# --- Access control ---
ROOT_USER_EMAIL=xklondon@gmail.com
INVITE_ONLY_MODE=true

# --- SMTP (optional in dev; required in production for magic links) ---
EMAIL_FROM=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
