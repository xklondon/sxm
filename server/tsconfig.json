{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false
  },
  "include": ["src/**/*", "../src/types/**/*", "../src/engine/**/*", "../src/lib/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "coverage",
    "playwright-report",
    "test-results",
    "**/*.test.ts",
    "**/*.test.js"
  ]
}
